{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "repo-ai-chat",
  "main": "src/server.ts",
  "compatibility_date": "2026-01-28",
  "compatibility_flags": ["nodejs_compat", "experimental"],

  // Anthropic API key — set via: wrangler secret put ANTHROPIC_API_KEY
  // (or add to .dev.vars for local development)

  // Cloudflare Artifacts (private beta) - uncomment when you have access
  // See: https://developers.cloudflare.com/artifacts/get-started/workers/
  // "artifacts": { "binding": "ARTIFACTS" },

  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agents/*"]
  },

  "durable_objects": {
    "bindings": [
      { "name": "RepoChatAgent", "class_name": "RepoChatAgent" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RepoChatAgent"] }
  ]
}
